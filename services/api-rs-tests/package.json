{
  "name": "@monobase/api-rs-tests",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Language-agnostic E2E tests for the Monobase API (works against both TS and Rust implementations)",
  "scripts": {
    "test": "bun test",
    "test:ts": "API_URL=http://localhost:7213 bun test",
    "test:rs": "API_URL=http://localhost:7213 bun test",
    "deps:up": "docker compose up -d --wait",
    "deps:down": "docker compose down -v"
  },
  "devDependencies": {
    "@faker-js/faker": "^9.0.0",
    "@types/bun": "latest",
    "@types/pg": "^8.15.5",
    "pg": "^8.16.3"
  }
}
