            match service.list_bir_accreditations(ctx).await {
                Ok(resp) => IpcResponse::success(resp.body),
                Err(e) => IpcResponse::error(e),
            }
        }
        ("POST", "/bir-accreditations") => {
            match service.create_bir_accreditation(ctx).await {
                Ok(resp) => IpcResponse::success(resp.body),
                Err(e) => IpcResponse::error(e),
            }
        }
        ("GET", "/bir-machines") => {
            match service.list_bir_machines(ctx).await {
                Ok(resp) => IpcResponse::success(resp.body),
                Err(e) => IpcResponse::error(e),
            }
        }
        ("POST", "/bir-machines") => {
            match service.create_bir_machine(ctx).await {
                Ok(resp) => IpcResponse::success(resp.body),
                Err(e) => IpcResponse::error(e),
            }
        }
        ("GET", "/bir/logs") => {
            match service.list_bir_logs(ctx).await {
                Ok(resp) => IpcResponse::success(resp.body),
                Err(e) => IpcResponse::error(e),
            }
        }
        ("POST", "/bir/logs") => {
            match service.create_bir_log(ctx).await {
                Ok(resp) => IpcResponse::success(resp.body),
                Err(e) => IpcResponse::error(e),
            }
        }
        ("GET", "/bir/readings") => {
            match service.list_bir_readings(ctx).await {
                Ok(resp) => IpcResponse::success(resp.body),
                Err(e) => IpcResponse::error(e),
            }
        }
        ("POST", "/bir/readings") => {
            match service.create_bir_reading(ctx).await {
                Ok(resp) => IpcResponse::success(resp.body),
                Err(e) => IpcResponse::error(e),
            }
        }
        _ => IpcResponse::not_found(),
    }
}
